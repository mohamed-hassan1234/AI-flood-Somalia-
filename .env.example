ENVIRONMENT=development
SECRET_KEY=replace-with-at-least-32-random-characters
MYSQL_DATABASE=somalia_ai
MYSQL_USER=replace-with-local-db-user
MYSQL_PASSWORD=replace-with-local-db-password
MYSQL_ROOT_PASSWORD=replace-with-local-root-password
DATABASE_URL=mysql+pymysql://replace-with-local-db-user:replace-with-local-db-password@mysql:3306/somalia_ai
REDIS_URL=redis://redis:6379/0
RATE_LIMIT_BACKEND=redis
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=replace-with-local-object-store-user
S3_SECRET_KEY=replace-me
CORS_ORIGINS=["http://localhost:5173"]
METRICS_TOKEN=replace-with-a-dedicated-monitoring-bearer-token
AUTH_RATE_LIMIT_PER_MINUTE=10
PUBLIC_RATE_LIMIT_PER_MINUTE=120
DASHBOARD_STALE_AFTER_HOURS=24
NOTIFICATION_PROVIDER=development
NOTIFICATION_GATEWAY_URL=
NOTIFICATION_GATEWAY_TOKEN=
NOTIFICATION_TIMEOUT_SECONDS=5
SEED_PASSWORD=replace-with-a-local-password-of-at-least-12-characters
